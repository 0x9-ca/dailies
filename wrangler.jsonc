    "DISCORD_GUILD_ID": "1544140186915700859",
    "DISCORD_ROLE_ADMIN": "1544140573491863662",
    "DISCORD_ROLE_EDITOR": "1544140999671156908",
    "EMAIL_AUTH_FROM": "noreply@dailies.0x9.ca",
    "EMAIL_AUTH_RATE_EMAIL_BURST_MAX": "3",
    "EMAIL_AUTH_RATE_EMAIL_BURST_WINDOW_SEC": "600",
    "EMAIL_AUTH_RATE_IP_BURST_MAX": "6",
    "EMAIL_AUTH_RATE_IP_BURST_WINDOW_SEC": "600",
    "EMAIL_AUTH_RATE_EMAIL_HOURLY_MAX": "8",
    "EMAIL_AUTH_RATE_EMAIL_HOURLY_WINDOW_SEC": "3600",
    "EMAIL_AUTH_RATE_IP_HOURLY_MAX": "20",
    "EMAIL_AUTH_RATE_IP_HOURLY_WINDOW_SEC": "3600",
    "EMAIL_AUTH_RATE_VERIFY_EMAIL_MAX": "8",
    "EMAIL_AUTH_RATE_VERIFY_EMAIL_WINDOW_SEC": "600",
    "EMAIL_AUTH_RATE_VERIFY_IP_MAX": "20",
