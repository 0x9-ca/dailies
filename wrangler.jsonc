{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-game-list",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-game-list",
      "database_id": "9e1124fc-5f00-4c21-a100-b807d8d46925",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "59fe208f58e2486884a6f2460f415b7a"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://192.168.17.2:8787",
    "SESSION_COOKIE_NAME": "dgl_session",
    "OAUTH_GOOGLE_CLIENT_ID": "700924319990-k4ud6jce7rartu07vosgl29h0gt8th7a.apps.googleusercontent.com",
    "OAUTH_GITHUB_CLIENT_ID": "Iv23lii8Q6cJmBRDG95K",
